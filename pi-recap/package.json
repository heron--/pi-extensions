{
  "name": "pi-recap",
  "version": "0.1.0",
  "private": true,
  "description": "Pi extension: durable, cursor-driven session recap logs generated on a periodic timer.",
  "type": "module",
  "main": "index.ts",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "settings": [
    { "key": "style", "prompt": "Recap style", "type": "choice", "choices": ["frame", "clean"], "default": "frame" },
    { "key": "intervalMinutes", "prompt": "Minutes between recap checks", "type": "number", "min": 0.05, "max": 240, "default": 5 },
    { "key": "minimumCompletedInteractions", "prompt": "Interactions needed for a recap", "type": "integer", "min": 1, "max": 1000, "default": 5 }
  ],
  "keywords": [
    "pi",
    "pi-package",
    "recap",
    "summary",
    "session"
  ]
}
