{
	"name": "pi-extensions-workspace",
	"version": "0.1.0",
	"private": true,
	"description": "Dev-only workspace for pi extensions: shared TypeScript toolchain. Not a pi package itself.",
	"type": "module",
	"scripts": {
		"sync-types": "node scripts/sync-pi-types.mjs",
		"typecheck": "npm run sync-types && tsc -p tsconfig.json",
		"test:tool-output": "npm run sync-types && node --no-warnings --experimental-strip-types --import ./scripts/pi-test-loader.mjs --test pi-tool-output/*.test.mjs && node pi-tool-output/integration.test.cjs && node pi-tool-output/group.test.cjs",
		"profile:tool-output": "npm run sync-types && node pi-tool-output/profile.cjs",
		"test:pricing": "npm run sync-types && node --test lib/pricing.test.cjs",
		"test:box": "npm run sync-types && node --no-warnings --experimental-strip-types --import ./scripts/pi-test-loader.mjs --test lib/box.test.mjs",
		"test:recap": "node --no-warnings --experimental-strip-types --test pi-recap/*.test.mjs",
		"test:transcript-digest": "npm run sync-types && node --no-warnings --experimental-strip-types --import ./scripts/pi-test-loader.mjs --test pi-transcript-digest/*.test.mjs",
		"profile:transcript-digest": "npm run sync-types && node --no-warnings --experimental-strip-types --import ./scripts/pi-test-loader.mjs pi-transcript-digest/profile.mjs",
		"test:context-footer": "npm run sync-types && node --no-warnings --experimental-strip-types --import ./scripts/pi-test-loader.mjs --test pi-context-footer/*.test.mjs",
		"test:install": "node --test scripts/install/*.test.mjs",
		"test:write-lock": "npm run sync-types && node --no-warnings --experimental-strip-types --import ./scripts/pi-test-loader.mjs --test pi-write-lock/*.test.mjs",
		"check": "npm run typecheck && npm run test:tool-output && npm run test:context-footer && npm run test:write-lock && npm run test:pricing && npm run test:box && npm run test:recap && npm run test:transcript-digest && npm run test:install",
		"watch": "npm run sync-types && tsc -p tsconfig.json --watch --preserveWatchOutput",
		"postinstall": "node scripts/sync-pi-types.mjs || true"
	},
	"devDependencies": {
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@pydantic/genai-prices": "^0.1.8"
	}
}
