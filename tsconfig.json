{
	// Shared typecheck config for every extension in this directory.
	//
	//   npm run typecheck    # one-shot check of all extensions
	//   npm run watch        # re-check on save while developing
	//
	// Package paths come from tsconfig.paths.json, which is generated by
	// scripts/sync-pi-types.mjs and points at your LIVE pi install, so the
	// types you check against are the ones your extensions actually run on.
	"extends": "./tsconfig.paths.json",
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2023"],
		"module": "esnext",
		"moduleResolution": "bundler",

		// pi loads .ts extensions directly; never emit build output.
		"allowImportingTsExtensions": true,
		"noEmit": true,

		"strict": true,
		"noUnusedLocals": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true,

		// pi's shipped .d.ts files are not ours to police, and we deliberately
		// pull in no @types/* ambient globals.
		"skipLibCheck": true,
		"types": []
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "**/node_modules", "**/dist"]
}
